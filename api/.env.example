# Aplicação
NODE_ENV=development
PORT=3000

# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plataforma_video
POSTGRES_PORT=5432

# Conexão da aplicação com o banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plataforma_video?schema=public

# Bunny Stream (painel > Stream > sua Video Library > API)
BUNNY_API_KEY=
# Chave "Read-only API Key" da mesma tela: usada para validar a assinatura dos webhooks
BUNNY_READ_ONLY_API_KEY=
BUNNY_LIBRARY_ID=
# Ex.: vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_CDN_HOSTNAME=
# Opcional: só se "Embed view token authentication" estiver ativo (aba Security)
BUNNY_TOKEN_AUTH_KEY=

# Login (JWT). Gere o segredo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7

# Moderação: espera (minutos) para pedir de novo a permissão de publicar após uma recusa.
UPLOAD_REQUEST_COOLDOWN_MINUTES=5

# Denúncias: quantas cada pessoa pode enviar a cada 24 horas.
REPORTS_PER_DAY=20

# Proxy confiável para o IP real de quem acessa (X-Forwarded-For).
# loopback = proxy na mesma máquina; número = quantos proxies na frente (ex.: 1 atrás do Cloudflare/nginx).
TRUST_PROXY=loopback

# Limites de tentativas (true/false; desligue só em testes).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_PER_ACCOUNT=5
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_COMMENTS_PER_MINUTE=10
RATE_LIMIT_COMMENTS_PER_DAY=200
